[Unit]
Description=Refresh Website Tracking GA4 cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/bintian/emw3-dashboard
Environment=NODE_ENV=production
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node --experimental-strip-types scripts/website-tracking-cache-worker.mjs --scheduled
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
