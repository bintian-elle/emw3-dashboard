[Unit]
Description=Serial persistent dashboard AI queue
After=network-online.target anc-dashboard-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/work/bintian/emw3-dashboard
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node scripts/ai-queue-worker.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
