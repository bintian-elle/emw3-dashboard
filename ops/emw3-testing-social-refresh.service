[Unit]
Description=Refresh shared Content Testing Social Media data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/work/bintian/emw3-dashboard
Environment=NODE_ENV=production
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node scripts/refresh-testing-social.mjs
TimeoutStartSec=6min
UMask=0077
NoNewPrivileges=true
