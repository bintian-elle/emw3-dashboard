[Unit]
Description=Refresh Google Testing snapshots starting at 05:15 Eastern

[Timer]
# Later ticks retry only while the snapshot is missing.
OnCalendar=*-*-* 05,06,07,08:15:00 America/New_York
Persistent=true
AccuracySec=1s
Unit=emw3-testing-google-refresh.service

[Install]
WantedBy=timers.target
