+def test_daily_batch_accepts_three_periods_and_two_lifetimes():
+    batch=result()
+    template=batch['period_readouts'][0]
+    labels=['Last Week (Tue–Mon)','Week-to-date','Month-to-date','Lifetime (Sep 24, 2026 – Now)','Lifetime snapshot']
+    batch['period_readouts']=[]
+    for label in labels:
+        row=deepcopy(template)
+        row['period']['label']=label
+        batch['period_readouts'].append(row)
+    assert len(TestingReadoutBatch.model_validate(batch).period_readouts)==5
+    batch['period_readouts'].append(deepcopy(template))
+    with pytest.raises(ValidationError): TestingReadoutBatch.model_validate(batch)
+
