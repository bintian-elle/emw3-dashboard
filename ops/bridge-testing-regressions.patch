+async def test_testing_waits_for_native_completion_past_ordinary_timeout(client_factory):
+    import asyncio
+    from test_dashboard import payload
+    provider=FakeProvider(result=json.dumps(result()),gate=asyncio.Event())
+    client=await client_factory(provider,timeout=1)
+    response=await client.post('/v1/codex/jobs',json=payload(mode='testing_readout'),headers=AUTH)
+    job=await response.json()
+    await provider.started.wait()
+    await asyncio.sleep(1.1)
+    current=await (await client.get('/v1/codex/jobs/'+job['job_id'],headers=AUTH)).json()
+    assert current['status']=='running'
+    provider.gate.set()
+    assert (await terminal(client,job['job_id']))['status']=='completed'
