# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# python
.venv/
**/__pycache__/

# Local credential-bearing script archive
/script存档

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-ai-tools/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local API credentials
/credentials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Durable private concluded-test snapshots (back up separately)
/.state/

# Isolated release verification build
/.next-release/

# Versioned production release artifacts
/.next-release*/

# Local Next.js development build output
/private/tmp/emw3-nova-dev/

# Local staging readability trial build
/.next-readable-staging/

/.next-readable-input/

/.next-readable-qa/
